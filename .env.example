# Copy this file to .env and fill in real values. NEVER commit .env.
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/Portfolio

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Origin of the React dev server (used by CORS)
CLIENT_URL=http://localhost:5173

# ---- Seeded administrator account -------------------------------------
# The admin password is NEVER stored in plain text. Generate a bcrypt hash:
#   npm run hash-password
# then paste the hash below. Keep the single quotes: bcrypt hashes contain "$".
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH='paste-bcrypt-hash-here'

# Set to true ONLY in a controlled test environment to enable DELETE-all routes
ALLOW_DELETE_ALL=false
